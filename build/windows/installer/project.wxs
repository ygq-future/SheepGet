<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="SheepGet"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="SheepGet"
           UpgradeCode="4C6B61F5-3E72-46A2-82D5-5E8E50C0C628">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="SheepGet" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="ManufacturerFolder" Name="SheepGet">
          <Directory Id="INSTALLFOLDER" Name="SheepGet" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SheepGet" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7D57B4A7-567F-4B7E-8FB8-04DCA72F0829">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="SheepGet"
                  Description="Modern Desktop Download Manager"
                  Target="[INSTALLFOLDER]sheep-get.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="ApplicationDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="SheepGet"
                  Description="Modern Desktop Download Manager"
                  Target="[INSTALLFOLDER]sheep-get.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SheepGet\SheepGet" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3E46C1A4-0B9F-4D0C-A925-9988D4E2F7C1" Win64="yes">
        <File Id="SheepGetEXE" Source="$(var.SourceDir)\sheep-get.exe" KeyPath="yes" />
      </Component>
      <Component Id="HostExecutable" Guid="98F1D64B-2B77-44DE-BE68-B057CC848972" Win64="yes">
        <File Id="SheepGetHostEXE" Source="$(var.SourceDir)\sheepget-host.exe" KeyPath="yes" />
      </Component>
      <Component Id="HostManifest" Guid="E6334F1A-D15F-4FE9-8A14-41133FBD5B42" Win64="yes">
        <File Id="SheepGetHostJSON" Source="$(var.SourceDir)\com.sheepget.host.json" KeyPath="yes" />
      </Component>
      <Component Id="HostRegistry" Guid="A7829C1F-3241-4FE9-8A14-41133FBD5B43" Win64="yes">
        <RegistryValue Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\com.sheepget.host" Value="[INSTALLFOLDER]com.sheepget.host.json" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.sheepget.host" Value="[INSTALLFOLDER]com.sheepget.host.json" Type="string" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
